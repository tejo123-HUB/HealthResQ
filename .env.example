# Copy to .env and adjust for local use. Docker Compose reads this automatically.

POSTGRES_USER=healthresq
POSTGRES_PASSWORD=healthresq
POSTGRES_DB=healthresq
POSTGRES_PORT=5432

# Used by the API container / local uvicorn run. Host is "db" inside compose, "localhost" when
# running the API directly on the host against `docker compose up db`.
DATABASE_URL=postgresql+psycopg://healthresq:healthresq@localhost:5432/healthresq

JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRY_MINUTES=480

# real: calls WHO GHO OData API (no key needed). mock: serves fixed sample values, zero network.
REFERENCE_INDICATOR_MODE=mock
REFERENCE_INDICATOR_REFRESH_DAYS=7
GHO_BASE_URL=https://ghoapi.azureedge.net/api

# Demo seed login (created by `python -m backend.seed`)
SEED_DEFAULT_PASSWORD=demo-pass-123

# Web container port on the host, and the address the browser uses to reach the API — must stay a
# browser-reachable host:port (not the compose-internal "api" hostname), since Next.js inlines
# NEXT_PUBLIC_* into the client bundle at build time.
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
